{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "innovation-radar-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "app",
                "output": "app"
              }
            ],
            "styles": ["app/style.css", "src/styles.css"],
            "scripts": [
              "app/data/seed.js",
              "app/core/evidence.js",
              "app/core/discovery.js",
              "app/core/assessment.js",
              "app/core/matching.js",
              "app/core/actions.js",
              "app/core/analysis.js",
              "app/core/pdf.js",
              "app/core/store.js",
              "app/core/localApi.js",
              "app/core/sources/openalex.js",
              "app/core/sources/ncbr.js",
              "app/core/onlineSearch.js",
              "app/app.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "innovation-radar-angular:build:production"
            },
            "development": {
              "buildTarget": "innovation-radar-angular:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}