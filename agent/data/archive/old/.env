# Ścieżka do pliku CSV z domenami i adresami stron
DOMAINS_FILE=sites.csv

# Lokalny serwer i model Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=SpeakLeash/bielik-11b-v2.3-instruct:Q4_K_M

# Limity i timeouty
CRAWLER_MAX_ARTICLES_PER_SITE=10
MAX_PAGES_PER_SITE=200
MAX_ARTICLE_CHARS=6000
REQUEST_TIMEOUT_SECONDS=25
OLLAMA_TIMEOUT_SECONDS=180
CRAWL_DELAY_MIN_SECONDS=0.2
CRAWL_DELAY_MAX_SECONDS=0.6
CRAWL_CONCURRENCY=4
ARTICLE_CONCURRENCY=3
