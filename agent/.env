SITES_FILE=data/sites.csv
SCRAPPED_DIR=data/scrapped
ANALYSIS_OUTPUT_FILE=results/results.json
LOG_FILE=logs/logs.txt
DELETE_SCRAPPED_AFTER_RUN=1

MAX_VISITED_PAGES=50
CRAWL_CONCURRENCY=8
CRAWLER_TIMEOUT_SECONDS=15

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=SpeakLeash/bielik-11b-v2.3-instruct:Q4_K_M
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=8192
AGENT_CONCURRENCY=1
MAX_ARTICLES_TO_PROCESS=0
AGENT_MAX_ARTICLE_CHARS=0

CRAWLER_AGENT_MODEL_PATH=models/crawler_agent.pt
CRAWLER_AGENT_DATASET_PATH=data/crawler_agent_data.json
CRAWLER_AGENT_HIDDEN_SIZE=32
CRAWLER_AGENT_TRAIN_EPOCHS=80
CRAWLER_AGENT_LEARNING_RATE=0.001
CRAWLER_AGENT_BATCH_SIZE=64
JS_RENDER_FALLBACK=1
JS_RENDER_TIMEOUT_SECONDS=20
JS_RENDER_MIN_ARTICLE_CHARS=200
LISTING_MIN_ARTICLE_LINKS=3
LOCAL_AGENT_MODEL_PATH=models/local_agent.pt
LOCAL_AGENT_HIDDEN_SIZE=64
LOCAL_AGENT_TRAIN_EPOCHS=25
LOCAL_AGENT_LEARNING_RATE=0.001
LOCAL_AGENT_BATCH_SIZE=32
LOCAL_AGENT_VALIDATION_FRACTION=0.2
LOCAL_AGENT_FILTER=1
LOCAL_AGENT_ARTICLE_THRESHOLD=0.5